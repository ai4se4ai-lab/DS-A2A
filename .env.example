# Copy to .env and edit. Selects the pluggable LLM backend used for @llm
# stochastic bindings (see docs/ARCHITECTURE.md).

# One of: ollama | openai | anthropic | mock
LLM_PROVIDER=ollama

# Model tag/name for the selected provider.
# Ollama example tags: qwen3:8b, qwen2.5:7b, llama3.1:8b
LLM_MODEL=qwen3:8b

# --- Ollama (local, default; no API key required) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=

# Sampling / validation
LLM_TEMPERATURE=0.2
LLM_MAX_RESAMPLES=3
