# hpc/config/cluster.env — site and project settings, sourced (set -a) by every job and by submit.py.
# submit.py freezes a copy into hpc/logs/<RUN_ID>/config/ so later edits never change a running study.

# ── Slurm ────────────────────────────────────────────────────────────────────
ACCOUNT="${ACCOUNT:-def-mbabaei_gpu}"            # `sshare -U` or `sacctmgr show assoc user=$USER` lists yours
MAIL_TYPE="${MAIL_TYPE:-FAIL}"                # FAIL | END,FAIL | NONE
MAX_REQUEUES="${MAX_REQUEUES:-20}"            # self-requeues per job after reaching the time limit
REQUEUE_SIGNAL_SECS=900                       # USR1 this many seconds before the time limit

# ── Software (Alliance: modules + wheelhouse; see references/alliance-cluster.md) ─
MODULES="StdEnv/2023 python/3.11"             # add e.g. cuda/12.2 arrow/24.0.0 as the project needs
#PIP_FIND_LINKS="${PIP_FIND_LINKS:-}"          # extra wheel dir for packages missing from the wheelhouse ($WORK/wheels)
SRC_DIRS="src"                                # added to PYTHONPATH (space list, relative to the repo); also hashed in the manifest
CODE_HASH_DIRS="src evaluation/harness evaluation/analysis"                          # code whose content hash goes into run_manifest.json

# ── Storage ──────────────────────────────────────────────────────────────────
# Active work on scratch (fast, purged, not backed up); final results copied to project (backed up).
WORK="${WORK:-${SCRATCH:-$HOME/scratch}/${PROJECT_NAME:-agentm2m_devbench}}"
RESULTS_DEST=""                               # "" = hpc/logs/<RUN_ID>/results (inside the repo on /project)

# ── GPU policy ───────────────────────────────────────────────────────────────
# Every stage must request a GPU unless experiments.json marks it "cpu_only": true.
# Inside the job, run_stage.py refuses to start if no GPU is visible.
GPU_MONITOR_SECS=60                           # nvidia-smi sampling interval (logs/<RUN_ID>/gpu/)

# ── Optional per-run variables available as {NAME} in experiments.json commands ─
PREFLIGHT_MODEL="qwen2.5-coder:7b"

# ── LLM service (Ollama, one private server per job; see hpc/slurm/hooks/all.sh) ──
# Binary: Ollama 0.40.0 on scratch (qwen3.8 needs >0.30.6); weights staged into $OLLAMA_MODELS from the login node (Narval GPU nodes are offline).
OLLAMA_PREFIX="${OLLAMA_PREFIX:-$SCRATCH/autom2m_hpc/opt/ollama-0.40.0}"
OLLAMA_MODELS="${OLLAMA_MODELS:-$WORK/ollama_models}"
OLLAMA_NUM_PARALLEL=1                         # the harness issues one call at a time
OLLAMA_MAX_LOADED_MODELS=1

# Wheels missing from the Alliance wheelhouse (pyecore, pytest-json-report, pyquery): staged once into $WORK/wheels.
PIP_FIND_LINKS="${PIP_FIND_LINKS:-$WORK/wheels}"
