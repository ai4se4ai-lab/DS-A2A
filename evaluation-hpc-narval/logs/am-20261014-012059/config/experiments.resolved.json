    }
   ]
  },
  {
   "name": "collect",
   "description": "Aggregate all cells: the paper's results table, RQ1 decision rule, per-model figures, generic CSV/MD/LaTeX tables, ledger and manifest.",
   "depends": [
    {
     "stage": "devbench",
     "type": "afterany"
    }
   ],
   "resources": {
    "gpus": "a100_1g.5gb:1",
    "cpus": 2,
    "mem": "16G",
    "time": "01:00:00"
   },
   "steps": [
    {
     "name": "paper_table",
     "cmd": "python hpc-narval/scripts/paper_table.py --logs {RESULTS}/devbench_logs --out {RESULTS}/analysis --models {MODELS_TO_PULL}",
     "needs": [
      "devbench_logs/devbench_rq1_*.jsonl"
     ],
     "produces": [
      "analysis/tab_results.csv"
     ],
     "always": true
    },
    {
     "name": "aggregate",
     "cmd": "mkdir -p {RESULTS}/analysis && EVAL_OUT_DIR={RESULTS}/analysis DEVBENCH_LOGS_DIR={RESULTS}/devbench_logs python -m evaluation.analysis.aggregate_devbench > {RESULTS}/analysis/aggregate_devbench.txt",
     "always": true
    },
    {
     "name": "figures",
     "cmd": "EVAL_OUT_DIR={RESULTS}/analysis DEVBENCH_LOGS_DIR={RESULTS}/devbench_logs python -m evaluation.analysis.make_two_model_figures --models {MODELS_TO_PULL}",
     "always": true
    },
    {
     "name": "collect",
     "builtin": "collect",
     "always": true
    }
   ],
   "cells": [
    {}
   ]
  }
 ],
 "results": {
  "tables": [
   {
    "name": "rq2_changes",
    "glob": "devbench_logs/devbench_rq2_*.jsonl",
    "description": "every injected change (RQ2)"
   },
   {
    "name": "rq3_reviewer",
    "glob": "devbench_logs/devbench_rq3_*.jsonl",
    "description": "HOT-added reviewer coverage (RQ3)"
   },
   {
    "name": "rq1_runs",
    "glob": "analysis/csv/devbench_raw_metrics_pooled.csv",
    "description": "every build run (RQ1), without transcripts"
   }
  ],
  "summaries": [
   {
    "name": "rq1_by_model_config",
    "table": "rq1_runs",
    "group_by": [
     "model",
     "config"
    ],
    "metrics": {
     "canary_pass": "sum",
     "canary_total": "sum",
     "acceptance_pass": [
      "mean",
      "rate"
     ],
     "mast_p1_count": "mean",
     "total_tokens": "mean",
     "repo": "count"
    },
    "caption": "RQ1 by model and configuration"
   },
   {
    "name": "rq2_by_model_config",
    "table": "rq2_changes",
    "group_by": [
     "model",
     "config"
    ],
    "metrics": {
     "precision": "mean",
     "recall": "mean",
     "tokens": "mean",
     "repo": "count"
    },
    "caption": "RQ2 change impact and cost"
   },
   {
    "name": "rq3_by_model",
    "table": "rq3_reviewer",
    "group_by": [
     "model"
    ],
    "metrics": {
     "retroactive_coverage": "mean",
     "tokens": "mean",
     "repo": "count"
    },
    "caption": "RQ3 reviewer coverage"
   }
  ],
  "plots": [
   {
    "name": "fig_rq2_precision",
    "summary": "rq2_by_model_config",
    "kind": "bar",
    "x": "model",
    "y": "precision_mean",
    "hue": "config",
    "title": "RQ2: impact precision"
   },
   {
    "name": "fig_rq2_tokens",
    "summary": "rq2_by_model_config",
    "kind": "bar",
    "x": "model",
    "y": "tokens_mean",
    "hue": "config",
    "title": "RQ2: tokens per change"
   },
   {
    "name": "fig_rq1_canaries",
    "summary": "rq1_by_model_config",
    "kind": "bar",
    "x": "model",
    "y": "canary_pass_sum",
    "hue": "config",
    "title": "RQ1: canaries in code"
   }
  ],
  "copy": [
