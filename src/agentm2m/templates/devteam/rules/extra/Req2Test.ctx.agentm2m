-- T4 with shared context: the Tester's oracle also reads 'security-review'.
module Req2Test;
create OUT : Test from IN : Req;
uses '../helpers.py';

rule Criterion2TestCase {
  from c : Req!Criterion
  to  tc : Test!TestCase (
    name      <- c.id,
    criterion <- c,
    oracle    <- @llm('Write a test oracle for this acceptance criterion: Python code defining a function test_oracle() that calls implementation() and asserts the criterion holds, and checks any applicable security finding. Answer with Python code only.',
                       c.text,
                       context = ['security-review']),
    @check oracle.failsOnStub() )
}
