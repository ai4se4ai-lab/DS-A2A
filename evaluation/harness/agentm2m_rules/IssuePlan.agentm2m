-- Evaluation-harness hand-off T1 (Issue -> Plan), the "agentm2m"
-- configuration's Analyst -> Architect step (Sec V "Design"): analogous in
-- shape to the paper's Req2Arch/Story2Operation (Sec III-B), adapted to
-- SWE-bench-shaped tasks. Two stochastic bindings, each footprint-bounded
-- to i.problem_statement only and gated by its own @check.
module IssuePlan;
create OUT : Plan from IN : Issue;
uses 'helpers.py';

rule Issue2Plan {
  from i : Issue!IssueRecord
  to  p : Plan!PatchPlan (
    id        <- i.id,
    operation <- @llm('Classify the kind of code change this issue needs, in one or two words (e.g. bugfix, feature, refactor).',
                       i.problem_statement),
    @check operation.not_blank(),
    rationale <- @llm('In 1-3 sentences, explain what needs to change and roughly where, to fix this issue.',
                       i.problem_statement),
    @check rationale.not_blank() )
}
