-- T2 (Architect -> Developer). Footprint is op.signature only (Prop. 2):
-- the Developer never sees the original PRD/criteria text directly, only
-- what the Architect's hand-off structurally carries forward.
module Arch2Code;
create OUT : Code from IN : Arch;
uses 'helpers.py';

rule Operation2CodeEdit {
  from op : Arch!Operation
  to  ce : Code!CodeEdit (
    name      <- op.name,
    operation <- op,
    body      <- @llm('Implement this operation as a complete Python function or method (a full "def name(...):" block matching this exact signature). If you need a library, import it inside the function body. Output ONLY the raw def block: no markdown code fences, no surrounding class/imports/explanation.',
                       op.signature),
    @check body.compiles() )
}
