-- T4 (Analyst -> Tester), direct hand-off bypassing Arch/Code (Fig. 1's
-- bent edge). Used for fidelity measurement (does every criterion get a
-- test, MAST FM-2.4/3.2) -- real "task success" grading uses DevBench's
-- own acceptance/unit tests (evaluation/harness/devbench_common.py), not
-- this generated oracle.
module Req2Test;
create OUT : Test from IN : Req;
uses 'helpers.py';

rule Criterion2TestCase {
  from c : Req!Criterion
  to  tc : Test!TestCase (
    name      <- c.text,
    criterion <- c,
    oracle    <- @llm('Write a test oracle for this acceptance criterion. The operation under test is available as a function named implementation (already defined; do NOT define or import it). Define def test_oracle(): that calls implementation(...) with concrete arguments and asserts the criterion holds with at most 3 assert statements. If the operation is a method, implementation is already bound to an instance: pass only the arguments after self, and never construct the class. Output ONLY the raw Python def block: no markdown code fences, no explanation.',
                       c.text),
    @check oracle.failsOnStub() )
}
